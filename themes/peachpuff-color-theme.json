{
  "$schema": "vscode://schemas/color-theme",
  "name": "Peachpuff (vim-port)",
  "type": "light",
  "colors": {
    "editor.background": "#ffdab9",
    "editor.foreground": "#000000",
    "editorCursor.foreground": "#000000",
    "editor.lineHighlightBackground": "#f5c195",
    "editorLineNumber.foreground": "#CD0000",
    "editorWhitespace.foreground": "#EBD5C6",
    "editor.selectionBackground": "#cccccc",
    "editor.inactiveSelectionBackground": "#cccccc88",
    "editor.findMatchBackground": "#cd00cd",
    "editor.findMatchHighlightBackground": "#cd00cd55",
    "errorForeground": "#FFFFFF",
    "editorError.foreground": "#FF0000",
    "editorError.background": "#FF000033",
    "editorWarning.foreground": "#FF0000",
    "statusBar.background": "#000000",
    "statusBar.foreground": "#FFFFFF",
    "statusBar.noFolderBackground": "#000000",
    "statusBar.debuggingBackground": "#000000",
    "statusBarItem.remoteBackground": "#737373",
    "activityBar.background": "#737373",
    "sideBar.background": "#FFF2E4",
    "titleBar.activeBackground": "#737373",
    "titleBar.activeForeground": "#FFFFFF",
    "list.activeSelectionBackground": "#CCCCCC",
    "list.hoverBackground": "#FFEEDD",
    "panel.border": "#737373",
    "editorGroup.border": "#737373",
    "tab.activeBackground": "#FFDAB9",
    "tab.inactiveBackground": "#F6E8D0",
    "badge.background": "#CD1076",
    "badge.foreground": "#FFFFFF",
    "diffEditor.insertedTextBackground": "#FFFFFF80",
    "diffEditor.removedTextBackground": "#F6E8D080",
    "diffEditor.diagonalFill": "#EDB5CD80",
    "editorGutter.addedBackground": "#2E8B57",
    "editorGutter.deletedBackground": "#FF0000",
    "editorGutter.modifiedBackground": "#6A5ACD",
    "editor.lineHighlightBorder": "#00000000",
    "editorLineNumber.activeForeground": "#cd0000",
    "editorBracketMatch.background": "#6a5acd26",
    "editorBracketMatch.border": "#6a5acd",
    "editorIndentGuide.background1": "#00000000",
    "editorIndentGuide.activeBackground1": "#00000000",
    "editor.wordHighlightBackground": "#00000000",
    "editor.wordHighlightStrongBackground": "#00000000",
    "editor.wordHighlightTextBackground": "#00000000",
    "editor.selectionHighlightBackground": "#00000000",
    "editorBracketHighlight.foreground1": "#000000",
    "editorBracketHighlight.foreground2": "#000000",
    "editorBracketHighlight.foreground3": "#000000",
    "editorBracketHighlight.foreground4": "#000000",
    "editorBracketHighlight.foreground5": "#000000",
    "editorBracketHighlight.foreground6": "#000000",
    "editorBracketHighlight.unexpectedBracket.foreground": "#000000"
  },
  "tokenColors": [
    {
      "name": "Comment",
      "scope": [
        "comment"
      ],
      "settings": {
        "foreground": "#406090",
        "fontStyle": ""
      }
    },
    {
      "name": "Constant",
      "scope": [
        "string",
        "constant.numeric",
        "constant.character",
        "constant.language"
      ],
      "settings": {
        "foreground": "#c00058",
        "fontStyle": ""
      }
    },
    {
      "name": "Special",
      "scope": [
        "constant.character.escape",
        "constant.other.placeholder"
      ],
      "settings": {
        "foreground": "#6a5acd",
        "fontStyle": ""
      }
    },
    {
      "name": "Statement",
      "scope": [
        "keyword",
        "keyword.control",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#a52a2a",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Operators plain",
      "scope": [
        "keyword.operator",
        "keyword.control.ternary"
      ],
      "settings": {
        "foreground": "#000000",
        "fontStyle": ""
      }
    },
    {
      "name": "Type / StorageClass",
      "scope": [
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#2e8b57",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Type builtin",
      "scope": [
        "support.type",
        "keyword.channel"
      ],
      "settings": {
        "foreground": "#2e8b57",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Functions plain",
      "scope": [
        "entity.name.function",
        "support.function"
      ],
      "settings": {
        "foreground": "#000000",
        "fontStyle": ""
      }
    },
    {
      "name": "Identifier builtin",
      "scope": [
        "support.function.builtin",
        "entity.name.function.support.builtin"
      ],
      "settings": {
        "foreground": "#008b8b",
        "fontStyle": ""
      }
    },
    {
      "name": "PreProc",
      "scope": [
        "meta.preprocessor",
        "keyword.control.directive",
        "punctuation.definition.directive"
      ],
      "settings": {
        "foreground": "#cd00cd",
        "fontStyle": ""
      }
    },
    {
      "name": "Python include/decorator",
      "scope": [
        "keyword.control.import.python",
        "punctuation.definition.decorator.python"
      ],
      "settings": {
        "foreground": "#cd00cd",
        "fontStyle": ""
      }
    },
    {
      "name": "Python statements",
      "scope": [
        "storage.type.class.python",
        "storage.type.function.python",
        "keyword.operator.logical.python"
      ],
      "settings": {
        "foreground": "#a52a2a",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Python literals",
      "scope": [
        "storage.type.number.python",
        "storage.type.string.python",
        "storage.type.format.python",
        "meta.fstring.python"
      ],
      "settings": {
        "foreground": "#c00058",
        "fontStyle": ""
      }
    },
    {
      "name": "Python Function/builtin",
      "scope": [
        "entity.name.function.python",
        "entity.name.type.class.python",
        "entity.name.function.decorator.python",
        "support.function.magic.python",
        "support.type.python"
      ],
      "settings": {
        "foreground": "#008b8b",
        "fontStyle": ""
      }
    },
    {
      "name": "Raw-string escapes",
      "scope": [
        "string.regexp constant.character.escape"
      ],
      "settings": {
        "foreground": "#c00058",
        "fontStyle": ""
      }
    },
    {
      "name": "Java include/annotation",
      "scope": [
        "keyword.other.package.java",
        "keyword.other.import.java",
        "storage.type.annotation.java",
        "punctuation.definition.annotation.java"
      ],
      "settings": {
        "foreground": "#cd00cd",
        "fontStyle": ""
      }
    },
    {
      "name": "Java names plain",
      "scope": [
        "storage.modifier.package.java",
        "storage.modifier.import.java",
        "storage.type.java",
        "storage.type.generic.java",
        "storage.type.object.array.java"
      ],
      "settings": {
        "foreground": "#000000",
        "fontStyle": ""
      }
    },
    {
      "name": "Java primitives",
      "scope": [
        "storage.type.primitive.java"
      ],
      "settings": {
        "foreground": "#2e8b57",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Java var",
      "scope": [
        "storage.type.local.java"
      ],
      "settings": {
        "foreground": "#a52a2a",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Javadoc tags",
      "scope": [
        "keyword.other.documentation"
      ],
      "settings": {
        "foreground": "#6a5acd",
        "fontStyle": ""
      }
    },
    {
      "name": "Javadoc param",
      "scope": [
        "comment.block.javadoc variable.parameter"
      ],
      "settings": {
        "foreground": "#008b8b",
        "fontStyle": ""
      }
    },
    {
      "name": "JS statements",
      "scope": [
        "storage.type.js",
        "storage.type.class.js",
        "storage.modifier.js",
        "storage.modifier.async.js",
        "keyword.operator.new.js",
        "variable.language.super.js"
      ],
      "settings": {
        "foreground": "#a52a2a",
        "fontStyle": "bold"
      }
    },
    {
      "name": "JS this/function",
      "scope": [
        "variable.language.this.js",
        "storage.type.function.js"
      ],
      "settings": {
        "foreground": "#008b8b",
        "fontStyle": ""
      }
    },
    {
      "name": "JS plain",
      "scope": [
        "storage.type.function.arrow.js",
        "keyword.control.from.js"
      ],
      "settings": {
        "foreground": "#000000",
        "fontStyle": ""
      }
    },
    {
      "name": "JS template expression",
      "scope": [
        "meta.template.expression"
      ],
      "settings": {
        "foreground": "#6a5acd",
        "fontStyle": ""
      }
    },
    {
      "name": "C typedef",
      "scope": [
        "keyword.other.typedef.c"
      ],
      "settings": {
        "foreground": "#2e8b57",
        "fontStyle": "bold"
      }
    },
    {
      "name": "C number suffix",
      "scope": [
        "keyword.other.unit"
      ],
      "settings": {
        "foreground": "#c00058",
        "fontStyle": ""
      }
    },
    {
      "name": "C macro name",
      "scope": [
        "entity.name.function.preprocessor"
      ],
      "settings": {
        "foreground": "#cd00cd",
        "fontStyle": ""
      }
    },
    {
      "name": "Error",
      "scope": [
        "invalid",
        "invalid.deprecated"
      ],
      "settings": {
        "foreground": "#ffffff",
        "background": "#ff0000"
      }
    },
    {
      "name": "Diff add",
      "scope": [
        "markup.inserted",
        "diff.inserted"
      ],
      "settings": {
        "foreground": "#2e8b57"
      }
    },
    {
      "name": "Diff delete",
      "scope": [
        "markup.deleted",
        "diff.deleted"
      ],
      "settings": {
        "foreground": "#ff0000"
      }
    },
    {
      "name": "Diff change",
      "scope": [
        "markup.changed",
        "diff.changed"
      ],
      "settings": {
        "foreground": "#6a5acd"
      }
    },
    {
      "name": "Title",
      "scope": [
        "markup.heading"
      ],
      "settings": {
        "foreground": "#cd00cd",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Bold",
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "fontStyle": "bold"
      }
    },
    {
      "name": "Italic",
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "fontStyle": "italic"
      }
    }
  ]
}